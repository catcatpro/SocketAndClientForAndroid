<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path name="cache_images" path="." />
    <external-cache-path name="external_cache_images" path="." />
    <files-path name="internal_images" path="." />
    <external-files-path name="external_images" path="Pictures" />

    <!-- 对应 Context.getFilesDir()，内部存储私有目录 -->
    <files-path name="internal_files" path="." />
    <!-- 对应 Context.getExternalFilesDir()，外部存储私有目录 -->
    <external-files-path name="external_files" path="." />
    <!-- 对应 Context.getCacheDir()，内部缓存目录 -->
    <cache-path name="cache" path="." />
    <!-- 对应 Environment.getExternalStorageDirectory()，外部存储根目录（需权限） -->
    <external-path name="external_root" path="." />
</paths>